<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="001-create-analyzer-tables" author="aicc-team">
        <comment>Create initial schema for analyzer_db</comment>
        
        <!-- analyzer_jobs table -->
        <createTable tableName="analyzer_jobs">
            <column name="job_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="eval_id" type="UUID" remarks="Logical link to evaluation_db">
                <constraints nullable="false"/>
            </column>
            <column name="account_number" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)" defaultValue="PROCESSING" remarks="PROCESSING, COMPLETED, FAILED">
                <constraints nullable="false"/>
            </column>
            <column name="start_time" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="end_time" type="TIMESTAMPTZ"/>
            <column name="error_trace" type="TEXT"/>
        </createTable>
        
        <!-- document_extractions table -->
        <createTable tableName="document_extractions">
            <column name="extraction_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="job_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_document_extractions_job" references="analyzer_jobs(job_id)" onDelete="CASCADE"/>
            </column>
            <column name="doc_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="raw_text" type="TEXT"/>
            <column name="extracted_kv_pairs" type="JSONB"/>
            <column name="extraction_latency_ms" type="INT"/>
        </createTable>
        
        <!-- prompt_logs table -->
        <createTable tableName="prompt_logs">
            <column name="prompt_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="job_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_prompt_logs_job" references="analyzer_jobs(job_id)" onDelete="CASCADE"/>
            </column>
            <column name="model_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="system_prompt" type="TEXT"/>
            <column name="user_prompt" type="TEXT"/>
            <column name="input_tokens" type="INT"/>
            <column name="output_tokens" type="INT"/>
            <column name="latency_ms" type="INT"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <!-- rule_evaluations table -->
        <createTable tableName="rule_evaluations">
            <column name="rule_eval_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="job_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_rule_evaluations_job" references="analyzer_jobs(job_id)" onDelete="CASCADE"/>
            </column>
            <column name="rule_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="passed" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="actual_value" type="TEXT"/>
            <column name="expected_value" type="TEXT"/>
            <column name="llm_reasoning" type="TEXT"/>
            <column name="confidence_score" type="NUMERIC(4,3)"/>
        </createTable>
        
        <!-- Create indexes -->
        <createIndex indexName="idx_analyzer_jobs_eval_id" tableName="analyzer_jobs">
            <column name="eval_id"/>
        </createIndex>
        
        <createIndex indexName="idx_document_extractions_job_id" tableName="document_extractions">
            <column name="job_id"/>
        </createIndex>
        
        <createIndex indexName="idx_prompt_logs_job_id" tableName="prompt_logs">
            <column name="job_id"/>
        </createIndex>
        
        <createIndex indexName="idx_rule_evaluations_job_id" tableName="rule_evaluations">
            <column name="job_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
